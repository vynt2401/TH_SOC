#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>
#include <math.h>
#include "system.h"
#include "altera_avalon_spi.h"
#include "altera_avalon_pio_regs.h"

// ==========================================
// 1. BASE ADDRESS & CONFIG
// ==========================================
#ifndef LED_7SEG_BASE
    #ifdef PIO_0_BASE
        #define LED_7SEG_BASE PIO_0_BASE
    #else
        #define LED_7SEG_BASE 0x11020
    #endif
#endif

#define MAX31865_CONFIG_REG 0x00
#define MAX31865_RTD_MSB_REG 0x01
#define MAX31865_RTD_LSB_REG 0x02

#define RREF 430.0f
#define RNOMINAL 100.0f
#define SAI_SO_OFFSET 1.6f

const unsigned char led_code[] = {
    0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90
};

// ==========================================
// 2. HAM HIEN THI LED
// ==========================================
void display_temp(float temp) {
    if (temp < 0) temp = 0;
    if (temp > 999) temp = 999;

    // Logic tách số cho LED
    int val_int = (int)(temp * 10);
    int tram = val_int / 100;
    int chuc = (val_int % 100) / 10;
    int donvi = val_int % 10;

    alt_u32 led_val = led_code[donvi] | (led_code[chuc] << 8) | (led_code[tram] << 16);
    led_val &= ~(1 << 15); // Bật dấu chấm

    IOWR_ALTERA_AVALON_PIO_DATA(LED_7SEG_BASE, led_val);
}

void max31865_write(alt_u8 addr, alt_u8 data) {
    alt_u8 tx_buf[2];
    tx_buf[0] = addr | 0x80;
    tx_buf[1] = data;
    alt_avalon_spi_command(SPI_0_BASE, 0, 2, tx_buf, 0, NULL, 0);
}

void max31865_read(alt_u8 addr, alt_u8 *buffer, int len) {
    alt_u8 tx_buf[1] = { addr & 0x7F };
    alt_avalon_spi_command(SPI_0_BASE, 0, 1, tx_buf, len, buffer, 0);
}

// ==========================================
// 3. MAIN (CHE DO DEBUG CHI TIET)
// ==========================================
int main() {
    printf("--- HE THONG BAT DAU DEBUG ---\n");

    // Cấu hình MAX31865
    max31865_write(MAX31865_CONFIG_REG, 0xD2);
    usleep(100000);

    while(1) {
        alt_u8 rtd_data[2];
        max31865_read(MAX31865_RTD_MSB_REG, rtd_data, 2);

        alt_u16 rtd_val = (rtd_data[0] << 8) | rtd_data[1];
        int fault = rtd_val & 0x01;
        rtd_val >>= 1;

        if (fault) {
            printf("[WARNING] Loi Sensor Fault!\n");
            max31865_write(MAX31865_CONFIG_REG, 0xD2);
        }

        // Tính toán Float
        float Rt = (float)rtd_val * RREF / 32768.0f;
        float temp_raw = (Rt - RNOMINAL) / (RNOMINAL * 0.00385f);
        float temp_chuan = temp_raw - SAI_SO_OFFSET;

        // --- KHU VỰC DEBUG CHI TIẾT ---

        // 1. Biến tổng (Nhân 10)
        int val_hien_thi = (int)(temp_chuan * 10);

        // 2. Tách biến
        int phan_nguyen = val_hien_thi / 10;
        int phan_thap_phan = abs(val_hien_thi % 10);

        // 3. In từng biến ra để kiểm tra
        printf("\n========== DEBUG INFO ==========\n");
        printf("Raw ADC Value : %d\n", rtd_val);
        printf("Gia tri nhan 10 (val_hien_thi): %d\n", val_hien_thi);
        printf("Phan nguyen     (phan_nguyen) : %d\n", phan_nguyen);
        printf("Phan thap phan  (phan_thap_phan): %d\n", phan_thap_phan);
        printf("=> KET QUA GHEP: %d.%d do C\n", phan_nguyen, phan_thap_phan);
        printf("================================\n");

        // --- HẾT DEBUG ---

        // Hiển thị ra LED thật
        display_temp(temp_chuan);

        usleep(1000000); // Delay 1s cho dễ nhìn log
    }
    return 0;
}
