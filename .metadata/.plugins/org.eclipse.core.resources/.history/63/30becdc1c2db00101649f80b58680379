#include <stdio.h>
#include <unistd.h>
#include <stdlib.h> // Để dùng hàm abs()
#include <math.h>
#include "system.h"
#include "altera_avalon_spi.h"
#include "altera_avalon_pio_regs.h"

// ==========================================
// CẤU HÌNH ĐỊA CHỈ (QUAN TRỌNG)
// ==========================================
// 1. LED: Dùng đúng tên bạn đã thấy trong system.h
#define LED_BASE  LED_7SEG_BASE

// 2. SPI: Dùng tên mặc định (như bạn yêu cầu giữ nguyên)
#define SPI_BASE  SPI_0_BASE

// ==========================================
// CẤU HÌNH MAX31865
// ==========================================
#define MAX31865_CONFIG_REG 0x00
#define MAX31865_RTD_MSB_REG 0x01
#define MAX31865_RTD_LSB_REG 0x02

// Thông số PT100
#define RREF 430.0f  // Điện trở tham chiếu
#define RNOMINAL 100.0f // Điện trở tại 0 độ C

// Mã LED 7 đoạn (0-9) - Active LOW
const unsigned char led_code[] = {
    0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90
};

// Hàm hiển thị số lên LED 7 đoạn
void display_temp(float temp) {
    if (temp < 0) temp = 0;
    if (temp > 999) temp = 999;

    int val_int = (int)(temp * 10);
    int tram = val_int / 100;
    int chuc = (val_int % 100) / 10;
    int donvi = val_int % 10;

    // HEX0: Đơn vị | HEX1: Chục | HEX2: Trăm
    alt_u32 led_val = led_code[donvi] | (led_code[chuc] << 8) | (led_code[tram] << 16);

    // Bật dấu chấm thập phân ở hàng chục
    led_val &= ~(1 << 15);

    // Ghi ra LED
    IOWR_ALTERA_AVALON_PIO_DATA(LED_BASE, led_val);
}

// Ghi 1 byte vào MAX31865
void max31865_write(alt_u8 addr, alt_u8 data) {
    alt_u8 tx_buf[2];
    tx_buf[0] = addr | 0x80; // MSB = 1 (Write)
    tx_buf[1] = data;
    alt_avalon_spi_command(SPI_BASE, 0, 2, tx_buf, 0, NULL, 0);
}

// Đọc n byte từ MAX31865
void max31865_read(alt_u8 addr, alt_u8 *buffer, int len) {
    alt_u8 tx_buf[1] = { addr & 0x7F }; // MSB = 0 (Read)
    alt_avalon_spi_command(SPI_BASE, 0, 1, tx_buf, len, buffer, 0);
}

int main() {
    printf("He thong khoi dong...\n");

    // 1. Cấu hình MAX31865 (Vbias=On, Auto=On)
    max31865_write(MAX31865_CONFIG_REG, 0xD2);
    usleep(100000);

    while(1) {
        alt_u8 rtd_data[2];

        // 2. Đọc ADC
        max31865_read(MAX31865_RTD_MSB_REG, rtd_data, 2);

        // Ghép 16 bit
        alt_u16 rtd_val = (rtd_data[0] << 8) | rtd_data[1];
        rtd_val >>= 1; // Bỏ bit lỗi

        // 3. Tính nhiệt độ
        float Rt = (float)rtd_val * RREF / 32768.0f;
        float temp = (Rt - RNOMINAL) / (RNOMINAL * 0.00385f);

        // 4. In ra màn hình (In số nguyên để tránh lỗi %f)
        int phan_nguyen = (int)temp;
        int phan_thap_phan = abs((int)((temp - phan_nguyen) * 100));

        printf("Res: %d Ohm | Temp: %d.%02d C\n", (int)Rt, phan_nguyen, phan_thap_phan);

        // 5. Hiển thị LED
        display_temp(temp);

        usleep(500000);
    }
    return 0;
}
