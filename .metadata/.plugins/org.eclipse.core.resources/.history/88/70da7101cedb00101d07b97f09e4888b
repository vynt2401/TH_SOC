#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>
#include <math.h>
#include "system.h"
#include "altera_avalon_spi.h"
#include "altera_avalon_pio_regs.h"

// ==========================================
// 1. GIỮ NGUYÊN KHAI BÁO BASE ADDRESS
// ==========================================
#ifndef LED_7SEG_BASE
    #ifdef PIO_0_BASE
        #define LED_7SEG_BASE PIO_0_BASE
    #else
        #define LED_7SEG_BASE 0x11020
    #endif
#endif

// Địa chỉ thanh ghi MAX31865
#define MAX31865_CONFIG_REG 0x00
#define MAX31865_RTD_MSB_REG 0x01
#define MAX31865_RTD_LSB_REG 0x02

// ==========================================
// 2. CẤU HÌNH CẢM BIẾN (GIỐNG ARDUINO)
// ==========================================
#define RREF 430.0f
#define RNOMINAL 100.0f
#define SAI_SO_OFFSET 1.6f  // Offset trừ đi giống code Arduino

const unsigned char led_code[] = {
    0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90
};

// Hàm hiển thị LED (Không đổi)
void display_temp(float temp) {
    if (temp < 0) temp = 0;
    if (temp > 999) temp = 999;

    int val_int = (int)(temp * 10);
    int tram = val_int / 100;
    int chuc = (val_int % 100) / 10;
    int donvi = val_int % 10;

    alt_u32 led_val = led_code[donvi] | (led_code[chuc] << 8) | (led_code[tram] << 16);
    led_val &= ~(1 << 15); // Bật dấu chấm

    IOWR_ALTERA_AVALON_PIO_DATA(LED_7SEG_BASE, led_val);
}

void max31865_write(alt_u8 addr, alt_u8 data) {
    alt_u8 tx_buf[2];
    tx_buf[0] = addr | 0x80;
    tx_buf[1] = data;
    alt_avalon_spi_command(SPI_0_BASE, 0, 2, tx_buf, 0, NULL, 0);
}

void max31865_read(alt_u8 addr, alt_u8 *buffer, int len) {
    alt_u8 tx_buf[1] = { addr & 0x7F };
    alt_avalon_spi_command(SPI_0_BASE, 0, 1, tx_buf, len, buffer, 0);
}

int main() {
    printf("He thong PT100 Calibrated (Giong Arduino)...\n");

    // Cấu hình: Vbias=On, Auto=On, FaultClear=On -> 0xD2
    max31865_write(MAX31865_CONFIG_REG, 0xD2);
    usleep(100000);

    while(1) {
        alt_u8 rtd_data[2];

        // Đọc dữ liệu MSB và LSB
        max31865_read(MAX31865_RTD_MSB_REG, rtd_data, 2);

        alt_u16 rtd_val = (rtd_data[0] << 8) | rtd_data[1];

        // Kiểm tra Fault (bit cuối cùng) - Tương tự thermo.readFault()
        int fault = rtd_val & 0x01;

        // Bỏ bit Fault để lấy giá trị ADC raw
        rtd_val >>= 1;

        if (fault) {
            // Nếu có lỗi, Arduino trả về -999, ở đây ta in cảnh báo và clear lỗi
            printf("Sensor Fault Detected!\n");
             // Gửi lại lệnh config để clear fault
            max31865_write(MAX31865_CONFIG_REG, 0xD2);
        }

        // --- TÍNH TOÁN THEO CÔNG THỨC CHUẨN ---

        // 1. Tính điện trở Rt: Rt = (ADC * RREF) / 32768
        float Rt = (float)rtd_val * RREF / 32768.0f;

        // 2. Tính nhiệt độ thô (tempC_tho)
        // Công thức tuyến tính chuẩn cho PT100: T = (Rt - R0) / (R0 * alpha)
        // Alpha = 0.00385
        float temp_tho = (Rt - RNOMINAL) / (RNOMINAL * 0.00385f);

        // 3. Áp dụng Offset (Calibration) giống Arduino
        // return tempC_tho - SAI_SO_OFFSET;
        float temp_calibrated = temp_tho - SAI_SO_OFFSET;

        // --- HIỂN THỊ (Console + LED) ---

        // Xử lý in ra console cho đẹp (giống LED)
        int val_for_print = (int)(temp_calibrated * 10);
        int phan_nguyen = val_for_print / 10;
        int phan_thap_phan = abs(val_for_print % 10);

        printf("Nhiet do: %d.%d C (Da tru offset %.1f)\n", phan_nguyen, phan_thap_phan, SAI_SO_OFFSET);

        // Hiển thị LED
        display_temp(temp_calibrated);

        usleep(1000000); // Delay 1s giống loop Arduino
    }
    return 0;
}
